# ==============================================================================
# OmniStream Social Video Downloader - Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="Enter your environment variable to continue"

# APP_URL: The public URL where this applet is hosted.
APP_URL="https://prabube.github.io/video-downloader/index.html"

# Server Port (default: 3000)
PORT=3000

# Directory for temporary download storage before client fetches
SCRATCH_DIR="./downloads_scratch"

# Maximum retention duration for downloaded media files before cron cleanup (in minutes)
RETENTION_MINUTES=20

# Operational Safeguards: Maximum allowed file download size (in Megabytes)
MAX_FILE_SIZE_MB=500

# Operational Safeguards: Maximum video duration permitted for processing (in minutes)
MAX_DURATION_MINUTES=20

# Maximum simultaneous active video download and ffmpeg muxing jobs
MAX_CONCURRENT_JOBS=3

# Path to yt-dlp binary (defaults to system PATH yt-dlp)
YT_DLP_PATH="yt-dlp"

# Path to ffmpeg binary (defaults to system PATH ffmpeg)
FFMPEG_PATH="ffmpeg"

# Optional: Path to Netscape/Mozilla cookies.txt file for authenticated/bot bypass
COOKIES_FILE="Enter your environment variable to continue"

# Optional Redis connection string for external Celery / BullMQ queue setup
REDIS_URL="Enter your environment variable to continue"
