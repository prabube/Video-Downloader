rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isDefaultAdmin() {
      return isVerified() && request.auth.token.email == 'prabube.mani@gmail.com';
    }

    function isWhitelistedAdmin() {
      return isVerified() && 
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.role == 'admin';
    }

    function isAdmin() {
      return isDefaultAdmin() || isWhitelistedAdmin();
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Allowed Users Whitelist
    match /allowed_users/{emailId} {
      // Anyone signed in can read if their email matches the whitelist document, or if admin
      allow get: if isVerified() && (request.auth.token.email == emailId || isAdmin());
      allow list: if isAdmin();
      
      // Only admins can add, modify, or remove whitelisted users
      allow write: if isAdmin();
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // User can create their profile on first login
      allow create: if isOwner(userId) && (
        // If not default admin, they cannot self-assign role: 'admin'
        (request.resource.data.role == 'user' || isDefaultAdmin() || isWhitelistedAdmin())
      ) || isAdmin();

      // Updates: owner can update their lastLoginAt or profile metadata, admin can update all
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
